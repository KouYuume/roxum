app [program] { pf: platform "@PLATFORM_URL@", sh: "@SET_HEADER_URL@" }

import pf.Handler
import pf.MethodRouter
import pf.Reply
import pf.Router
import pf.HeaderName
import pf.IpAddr
import pf.Server
import sh.SetHeader

Model := {}

program = { init!, routes: Router.build(routes, {}) }

init! : {} => Try({ model : Model, listen : Server.ListenOptions }, [StartupErr(Str)])
init! = |{}| Ok({
	model: {},
	listen: {
		endpoint: Server.Endpoint.Tcp({ address: IpAddr.V4((127, 0, 0, 1)), port: 0 }),
		timeouts: Server.Timeouts.defaults,
		limits: Server.Limits.defaults,
	},
})

routes : Router(Model, [], {})
routes =
	Router.new
		|> Router.route("/", MethodRouter.get(Handler.static(|{}| Reply.text("from the bundle\n"))))
		|> Router.layer(SetHeader.layer(HeaderName.("x-from"), "the integration's bundle"))
