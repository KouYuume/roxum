{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/verify_local_check.py\" agent-hook",
            "statusMessage": "Checking that the commit passed the local checks"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent_policy.py\" codex",
            "statusMessage": "Checking for operations that change GitHub"
          }
        ]
      }
    ]
  }
}
